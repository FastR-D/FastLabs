# Copy this file to .fastlab/fastlab.env and keep it mode 600.

# Server authentication and public reverse-proxy path.
FASTLAB_AUTH_MODE=research
FASTRESEARCH_API_URL=http://127.0.0.1:8787
FASTRESEARCH_COOKIE_NAME=fr_session
FASTRESEARCH_PANEL_URL=https://research.example.com/
FASTLAB_PUBLIC_URL=https://research.example.com/lab/
FASTLAB_PUBLIC_PATH=/lab
FASTLAB_PORT=4180

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FASTLAB_CREDENTIAL_MASTER_KEY=replace-with-fernet-key
FASTLAB_TENANT_ROOT=/srv/fastlab/tenants

# Prebuilt image containing git, codex and claude CLIs.
FASTLAB_WORKER_IMAGE=fastlab-worker:latest
FASTLAB_CODEX_MODELS=
FASTLAB_CLAUDE_MODELS=sonnet,opus
FASTLAB_GLOBAL_CONCURRENCY=4
FASTLAB_MAX_CONCURRENCY_PER_USER=2
FASTLAB_CONTAINER_CPUS=2
FASTLAB_CONTAINER_MEMORY=4g
FASTLAB_CONTAINER_PIDS=256

# Choose one local Planner: codex or claude.
FASTLAB_PLANNER_BACKEND=codex

# Local CLI commands used by Planners and Workers.
FASTLAB_CODEX_BIN=codex
FASTLAB_CLAUDE_BIN=claude

# Planner, Worker and Verifier total timeout in seconds. Use 0 for no limit.
FASTLAB_AGENT_TIMEOUT=3600

# Optional: pre-approve additional Claude Worker commands with precise rules.
# Modern Claude uses auto mode; Planner/Verifier use dontAsk with read-only tools.
# Keep this as a JSON array. Bare "Bash" / "Bash(*)" is rejected.
# FASTLAB_CLAUDE_EXTRA_ALLOWED_TOOLS=["Bash(npm run *)","Bash(npx vitest *)"]
