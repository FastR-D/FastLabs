# FastLab production example. Copy to /srv/fastlab/config/fastlab.env,
# replace every placeholder, and keep the resulting file mode 0600.

# FastResearch authentication and same-origin reverse-proxy path.
FASTLAB_AUTH_MODE=research
FASTRESEARCH_API_URL=http://127.0.0.1:8787
FASTRESEARCH_COOKIE_NAME=fr_session
FASTRESEARCH_PANEL_URL=https://research.example.com/
FASTLAB_PUBLIC_URL=https://research.example.com/lab/
FASTLAB_PUBLIC_PATH=/lab
FASTLAB_PORT=4180

# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up this key separately. Changing it makes saved Provider keys unreadable.
FASTLAB_CREDENTIAL_MASTER_KEY=replace-with-a-new-fernet-key
FASTLAB_TENANT_ROOT=/srv/fastlab/tenants

# Trusted-internal first release: direct CLIs with strict Linux sandboxes.
# Docker remains an optional stronger backend; it is not required for process.
FASTLAB_EXECUTION_BACKEND=process
FASTLAB_CODEX_BIN=/opt/fastlab-cli/bin/codex
FASTLAB_CLAUDE_BIN=/opt/fastlab-cli/bin/claude

# 4U8G baseline. Keep the supported maximum (32) for larger tested hosts only.
FASTLAB_GLOBAL_CONCURRENCY=4
FASTLAB_MAX_CONCURRENCY_PER_USER=1

# One read-only Planner per task: codex or claude.
FASTLAB_PLANNER_BACKEND=codex
FASTLAB_CODEX_MODELS=
FASTLAB_CLAUDE_MODELS=sonnet,opus

# Planner, Worker and Verifier timeout in seconds; 0 disables the total timeout.
FASTLAB_AGENT_TIMEOUT=3600

# Optional precise Claude Worker rules. This value must be a JSON string array.
# Bare "Bash" and "Bash(*)" are rejected.
# FASTLAB_CLAUDE_EXTRA_ALLOWED_TOOLS=["Bash(npm run *)","Bash(python -m unittest *)"]

# Docker-only settings. Uncomment all of these only after changing the backend.
# Use an immutable release tag or digest, never latest.
# FASTLAB_WORKER_IMAGE=fastlab-worker:2026-09-25
# FASTLAB_CONTAINER_CPUS=2
# FASTLAB_CONTAINER_MEMORY=4g
# FASTLAB_CONTAINER_PIDS=256
