FROM node:22-bookworm-slim

ARG CODEX_VERSION=latest
ARG CLAUDE_CODE_VERSION=latest

RUN apt-get update \
    && apt-get install -y --no-install-recommends git python3 python3-venv ca-certificates curl \
    && npm install -g "@openai/codex@${CODEX_VERSION}" "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && rm -rf /var/lib/apt/lists/* /root/.npm

RUN mkdir -p /workspace /runtime /fastlab/schemas /fastlab/skills \
    && chmod 1777 /workspace /runtime

WORKDIR /workspace
