{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "subtasks", "acceptance"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "instructions", "weight", "dependencies", "executor"],
        "properties": {
          "key": {"type": "string", "pattern": "^S[1-9][0-9]*$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 80},
          "instructions": {"type": "string", "minLength": 1},
          "weight": {"type": "integer", "minimum": 1, "maximum": 5},
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "pattern": "^S[1-9][0-9]*$"}
          },
          "executor": {"type": "string", "enum": ["codex", "claude"]}
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "criterion": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
